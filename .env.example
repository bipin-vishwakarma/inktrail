# ==============================================================================
# InkTrail — Environment Configuration
# ==============================================================================
# InkTrail works 100% out of the box in "Instant Student Demo Mode" without
# any backend or API keys required (client-side localStorage & PDF generation).
#
# To enable PRODUCTION Supabase Authentication (Google OAuth, GitHub, Magic Link OTP)
# and cloud document backup, create a free project at https://supabase.com and fill in:

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# Optional: Google Gemini AI Key (for AI Humanizer / auto-formatting)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
